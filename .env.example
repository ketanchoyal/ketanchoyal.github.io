# GitHub Personal Access Token for API requests
# Create one at https://github.com/settings/tokens
# Required scopes: public_repo, read:user
NEXT_PUBLIC_GITHUB_TOKEN=your_github_token_here

# WakaTime API Key for coding statistics
# Get your API key from https://wakatime.com/settings/api-key
# This should be your WakaTime Secret API Key, not the public key
NEXT_PUBLIC_WAKATIME_API_KEY=your_wakatime_api_key_here
